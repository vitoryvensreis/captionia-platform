APP_ENV=production
APP_DEBUG=false
APP_URL=https://caption.escotilhaprodutora.com
APP_KEY=
APP_TIMEZONE=America/Fortaleza

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=caption
DB_USERNAME=captionuser
DB_PASSWORD=

SESSION_COOKIE=captionia_session
SESSION_LIFETIME_DAYS=30
SESSION_SECURE=true

API_ACCESS_MINUTES=20
API_REFRESH_DAYS=90

ADMIN_EMAIL=

PAYMENT_GATEWAY=bacen_pix
BACEN_PIX_KEY=
BACEN_PIX_NAME=CAPTION IA
BACEN_PIX_CITY=FORTALEZA
BACEN_PIX_ORDER_EXPIRATION_MINUTES=1440

PAGBANK_ENV=sandbox
PAGBANK_CHECKOUT_MODE=hosted
PAGBANK_TOKEN=
PAGBANK_PIX_EXPIRATION_MINUTES=30
PAGBANK_WEBHOOK_VERIFY=true
PAGBANK_PUBLIC_KEY_CACHE_HOURS=12

CAPTIONIA_CURRENT_VERSION=3.4.3
CAPTIONIA_CURRENT_MAJOR=3

# Cloud Core desligado ate testes de homologacao com Premiere.
CAPTIONIA_CLOUD_CORE_ENABLED=false
CAPTIONIA_CLOUD_CORE_MAJOR=3
CAPTIONIA_CLOUD_MAX_REQUESTS_PER_MINUTE=30

CAPTIONIA_CLOUD_ASSETS_ENABLED=false

# Ative em producao apenas apos deploy, testes com licencas e rotacao de qualquer chave compartilhada.
CAPTIONIA_CLOUD_TRANSCRIPTION_ENABLED=false
# Sem cota diaria do Caption IA. Groq e limite antiabuso por minuto continuam ativos.
GROQ_API_KEY=

# Afiliados: desligado por padrao (ligar no painel Admin apos testes).
# Gere uma chave hexadecimal forte com: openssl rand -hex 32
# Nao altere a chave depois de receber solicitacoes de saque,
# ou as chaves Pix criptografadas deixarao de poder ser lidas.
AFFILIATE_PAYOUT_KEY=
